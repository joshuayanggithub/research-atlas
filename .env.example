# Copy to .env and fill in. All optional for the MVP, but recommended.

# OpenAlex "polite pool" contact — a valid email gets faster, more reliable service.
OPENALEX_MAILTO=you@example.com

# Optional OpenAlex API key (freemium). Raises daily quota; not required for the capped MVP pull.
OPENALEX_API_KEY=

# Optional Semantic Scholar API key. Without it, SPECTER2 fetching is rate-limited (~1 req/s)
# and s03 will likely fall back to local SciNCL. Request one at semanticscholar.org/product/api.
S2_API_KEY=
