# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment
.env

# Pipeline intermediates (regenerable). Raw pulls + interim artifacts are large.
data/raw/
data/interim/
data/artifacts/
pipeline/.cache/

# The emitted artifact bundle is generated by s11 into web/public/data.
# Keep the directory but ignore generated files (they can be large-ish).
web/public/data/*
!web/public/data/.gitkeep

# Node / web
web/node_modules/
web/dist/
web/.vite/

# OS / editor
.DS_Store
*.log
build.log
