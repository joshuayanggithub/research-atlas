# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
*.egg-info/

# Environment
.env

# Pipeline intermediates (regenerable). Raw pulls + interim artifacts are large.
data/raw/
data/interim/
data/artifacts/
# Bulk third-party corpora downloaded by the pipeline. s2ag alone is 95 GB and comet 2.3 GB;
# they are regenerable from their upstreams and must never enter git history.
data/s2ag/
data/comet/
data/cache/
pipeline/.cache/

# Local clones of related/prior-work source repositories used for design research.
.prior-work-repos/

# The emitted artifact bundle is generated by s11 into web/public/data.
# Keep the directory but ignore generated files (they can be large-ish).
web/public/data/*
!web/public/data/.gitkeep

# Node / web
web/node_modules/
web/dist/
web/.vite/

# Playwright e2e artifacts
web/test-results/
web/playwright-report/
web/.playwright/

# OS / editor
.DS_Store
*.log
build.log
playwright-responses/
.playwright-mcp/
*.png

# TypeScript build cache
web/tsconfig.tsbuildinfo

# Keep README screenshots (override the *.png ignore above)
!docs/screenshots/
!docs/screenshots/*.png

# Personal reading-list exports (tools/zotero_export.py). Your library, not the project's.
reading-list*.json
